# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TMDB — https://www.themoviedb.org/settings/api (use the v4 "Read Access Token", not the v3 API key)
TMDB_API_KEY=

# RapidAPI — Streaming Availability API (movie-of-the-night)
# https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
RAPIDAPI_KEY=
RAPIDAPI_STREAMING_HOST=streaming-availability.p.rapidapi.com

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Public URL this app is served from, used to build the QR/join link.
# Local dev: http://localhost:3000
# Vercel: your production URL, e.g. https://tonight-we-watch.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
